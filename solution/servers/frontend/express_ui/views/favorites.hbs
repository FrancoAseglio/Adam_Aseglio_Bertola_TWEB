<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
    {{> navbar}}
    
    <div class="header-gradient pink">
        <div class="container">
            <h1>❤️ {{username}}'s Favorites</h1>
            <p>All favorite anime</p>
        </div>
    </div>

    <div class="container mb-5">
        {{#if favorites}}
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">
                    Favorites 
                    {{#if pagination}}
                        <span class="badge bg-pink">{{pagination.totalItems}} total</span>
                    {{else}}
                        <span class="badge bg-pink">{{favorites.length}} total</span>
                    {{/if}}
                </h2>
            </div>

            <div class="row g-4">
                {{#each favorites}}
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    {{#if this.details}}
                        {{#if (eq this.fav_type "anime")}}
                            <!-- Anime Card -->
                            <div class="card anime-card h-100" style="cursor: pointer;" onclick="window.location.href='/anime/{{this.id}}'">
                                {{#if this.details.image_url}}
                                <img src="{{this.details.image_url}}" alt="{{this.details.title}}" class="card-img-top" 
                                     style="height:300px;object-fit:cover" 
                                     onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                                {{else}}
                                <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" 
                                     alt="{{this.details.title}}" class="card-img-top" style="height:300px;object-fit:cover">
                                {{/if}}
                                <div class="card-body">
                                    <h6 class="card-title text-primary">{{this.details.title}}</h6>
                                    {{#if this.details.type}}
                                    <p class="card-text small text-muted mb-1"><strong>Type:</strong> {{this.details.type}}</p>
                                    {{/if}}
                                    {{#if this.details.episodes}}
                                    <p class="card-text small text-muted mb-1"><strong>Episodes:</strong> {{this.details.episodes}}</p>
                                    {{/if}}
                                    {{#if this.details.score}}
                                    <p class="card-text small text-muted mb-1">
                                        <strong>Score:</strong> 
                                        <span class="badge {{#if (gt this.details.score 8)}}bg-success{{else if (gt this.details.score 7)}}bg-info{{else}}bg-secondary{{/if}}">
                                            ⭐ {{this.details.score}}
                                        </span>
                                    </p>
                                    {{/if}}
                                    {{#if this.details.genres}}
                                    <p class="card-text small text-muted mb-1"><strong>Genres:</strong> {{formatList this.details.genres}}</p>
                                    {{/if}}
                                </div>
                            </div>
                        {{else if (eq this.fav_type "character")}}
                            <!-- Character Card -->
                            <div class="card anime-card h-100" style="cursor: pointer;" onclick="window.location.href='/characters/{{this.id}}'">
                                {{#if this.details.image_url}}
                                <img src="{{this.details.image_url}}" alt="{{this.details.name}}" class="card-img-top" 
                                     style="height:300px;object-fit:cover" 
                                     onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                                {{else}}
                                <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" 
                                     alt="{{this.details.name}}" class="card-img-top" style="height:300px;object-fit:cover">
                                {{/if}}
                                <div class="card-body">
                                    <h6 class="card-title text-primary">{{this.details.name}}</h6>
                                    {{#if this.details.name_kanji}}
                                    <p class="card-text small text-muted mb-1"><strong>Kanji:</strong> {{this.details.name_kanji}}</p>
                                    {{/if}}
                                    <p class="card-text small text-muted mb-1"><strong>Type:</strong> Character</p>
                                    {{#if this.details.favorites}}
                                    <p class="card-text small text-muted mb-1">
                                        <strong>Favorites:</strong> 
                                        <span class="badge bg-danger">❤️ {{this.details.favorites}}</span>
                                    </p>
                                    {{/if}}
                                </div>
                            </div>
                        {{else if (eq this.fav_type "people")}}
                            <!-- People Card -->
                            <div class="card anime-card h-100" style="cursor: pointer;" onclick="window.location.href='/people/{{this.id}}'">
                                {{#if this.details.image_url}}
                                <img src="{{this.details.image_url}}" alt="{{this.details.given_name}} {{this.details.family_name}}" class="card-img-top" 
                                     style="height:300px;object-fit:cover" 
                                     onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                                {{else}}
                                <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" 
                                     alt="{{this.details.given_name}} {{this.details.family_name}}" class="card-img-top" style="height:300px;object-fit:cover">
                                {{/if}}
                                <div class="card-body">
                                    <h6 class="card-title text-primary">{{this.details.given_name}} {{this.details.family_name}}</h6>
                                    {{#if this.details.given_name_native}}
                                    <p class="card-text small text-muted mb-1"><strong>Kanji:</strong> {{this.details.given_name_native}} {{this.details.family_name_native}}</p>
                                    {{/if}}
                                    <p class="card-text small text-muted mb-1"><strong>Type:</strong> Person</p>
                                    {{#if this.details.favorites}}
                                    <p class="card-text small text-muted mb-1">
                                        <strong>Favorites:</strong> 
                                        <span class="badge bg-danger">❤️ {{this.details.favorites}}</span>
                                    </p>
                                    {{/if}}
                                </div>
                            </div>
                        {{/if}}
                    {{else}}
                        <!-- Fallback Card -->
                        <div class="card anime-card h-100">
                            <img src="https://via.placeholder.com/225x350/6c757d/ffffff?text=No+Details" 
                                 alt="Unknown" class="card-img-top" style="height:300px;object-fit:cover">
                            <div class="card-body">
                                <h6 class="card-title text-muted">ID: {{this.id}}</h6>
                                <p class="card-text small text-muted mb-1"><strong>Type:</strong> {{this.fav_type}}</p>
                                <p class="card-text small text-muted">Details not available</p>
                            </div>
                        </div>
                    {{/if}}
                </div>
                {{/each}}
            </div>

            {{> pagination baseUrl=(concat "/favorites/" username) urlSeparator="?"}}
        {{else}}
        <div class="text-center py-5">
            <h2 class="text-muted">😕 No Favorites Found</h2>
            <p class="text-muted">This user hasn't added any anime to their favorites yet.</p>
            <a href="/anime/search" class="btn btn-primary mt-3">🔍 Search Anime</a>
        </div>
        {{/if}}

        <div class="text-center mt-4">
            <a href="/profile/{{username}}" class="btn btn-outline-primary">👤 View Full Profile</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
