<div class="container mt-5">
    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3 hero-title">
            🎬 Anime Explorer
        </h1>
        <p class="lead text-muted mb-4">Discover, track, and explore your favorite anime.</p>
    </div>

    <!-- Global Statistics Section -->
    {{#if globalStats}}
    <div class="row mb-5">
        <div class="col-12">
            <div id="statsCarousel" class="carousel slide" data-bs-ride="false">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="d-flex justify-content-center px-2">
                            <div class="card stats-carousel-card primary">
                                <div class="stats-icon">🎬</div>
                                <h2 class="display-3 fw-bold text-white mb-3">{{globalStats.totalAnime}}</h2>
                                <p class="text-white-50 mb-0 fs-4">Total Anime</p>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="d-flex justify-content-center px-2">
                            <div class="card stats-carousel-card green">
                                <div class="stats-icon">👥</div>
                                <h2 class="display-3 fw-bold text-white mb-3">{{globalStats.totalProfiles}}</h2>
                                <p class="text-white-50 mb-0 fs-4">Total Users</p>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="d-flex justify-content-center px-2">
                            <div class="card stats-carousel-card orange">
                                <div class="stats-icon">⭐</div>
                                <h2 class="display-3 fw-bold text-white mb-3">{{globalStats.totalRatings}}</h2>
                                <p class="text-white-50 mb-0 fs-4">Total Ratings</p>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="d-flex justify-content-center px-2">
                            <div class="card stats-carousel-card pink">
                                <div class="stats-icon">❤️</div>
                                <h2 class="display-3 fw-bold text-white mb-3">{{globalStats.totalFavorites}}</h2>
                                <p class="text-white-50 mb-0 fs-4">Total Favorites</p>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#statsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#statsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
    {{/if}}

    <!-- Feature Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-lift feature-card" onclick="window.location.href='/anime/search'">
                <div class="card-body text-center p-4">
                    <div class="mb-3 feature-icon">🎥</div>
                    <h5 class="card-title fw-bold mb-3">Browse Anime</h5>
                    <p class="card-text text-muted">Search anime by title, genre, explore top-rated series and view anime statistics</p>
                    <div class="mt-3">
                        <span class="badge bg-info me-1">Search</span>
                        <span class="badge bg-info me-1">Top Rated</span>
                        <span class="badge bg-info me-1">By Genre</span>
                        <span class="badge bg-info">Anime Stats</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-lift feature-card" onclick="window.location.href='/characters/search'">
                <div class="card-body text-center p-4">
                    <div class="mb-3 feature-icon">🦸</div>
                    <h5 class="card-title fw-bold mb-3">Characters</h5>
                    <p class="card-text text-muted">Search characters, view details, add or remove characters from the database</p>
                    <div class="mt-3">
                        <span class="badge bg-warning me-1">Search</span>
                        <span class="badge bg-warning me-1">Details</span>
                        <span class="badge bg-warning me-1">Add</span>
                        <span class="badge bg-warning">Remove</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-lift feature-card" onclick="window.location.href='/profile'">
                <div class="card-body text-center p-4">
                    <div class="mb-3 feature-icon">👤</div>
                    <h5 class="card-title fw-bold mb-3">User Profiles</h5>
                    <p class="card-text text-muted">Search and view user profiles, favorites, ratings and statistics</p>
                    <div class="mt-3">
                        <span class="badge bg-success me-1">Profile</span>
                        <span class="badge bg-success me-1">Favorites</span>
                        <span class="badge bg-success me-1">Ratings</span>
                        <span class="badge bg-success">User Stats</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Manage Data Section -->
    <div class="mb-5">
        <h2 class="text-center mb-4 fw-bold manage-data-title">📝 Manage Data</h2>
        
        <div class="row g-4">
            <!-- Add Character -->
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm manage-data-card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">➕ Add Character</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Character Name</label>
                            <input type="text" class="form-control form-control-sm" id="addCharName" placeholder="e.g., Monkey D. Luffy">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Image URL</label>
                            <input type="text" class="form-control form-control-sm" id="addCharImage" placeholder="e.g., https://cdn.myanimelist.net/...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">About/Description</label>
                            <textarea class="form-control form-control-sm" id="addCharAbout" rows="2" placeholder="e.g., Luffy is the captain..."></textarea>
                        </div>
                        <div class="manage-data-card-button">
                            <button class="btn btn-warning w-100" onclick="addCharacterFromForm()">Add Character</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Remove Character -->
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm manage-data-card">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">➖ Remove Character</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Character ID (MAL ID)</label>
                            <input type="number" class="form-control form-control-sm" id="removeCharId" placeholder="e.g., 40" min="1">
                        </div>
                        <div class="manage-data-card-button">
                            <button class="btn btn-danger w-100" onclick="removeCharacterFromForm()">Remove Character</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add Favorite -->
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm manage-data-card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">⭐ Add Favorite</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Username</label>
                            <input type="text" class="form-control form-control-sm" id="addFavUsername" placeholder="e.g., CKK2">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Anime ID (MAL ID)</label>
                            <input type="number" class="form-control form-control-sm" id="addFavItemId" placeholder="e.g., 21 (for One Piece)" min="1">
                        </div>
                        <div class="manage-data-card-button">
                            <button class="btn btn-primary w-100" onclick="addFavoriteFromForm()">Add Favorite</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Remove Favorite -->
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm manage-data-card">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">❌ Remove Favorite</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Username</label>
                            <input type="text" class="form-control form-control-sm" id="removeFavUsername" placeholder="e.g., CKK2">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Anime ID (MAL ID)</label>
                            <input type="number" class="form-control form-control-sm" id="removeFavItemId" placeholder="e.g., 21 (for One Piece)" min="1">
                        </div>
                        <div class="manage-data-card-button">
                            <button class="btn btn-danger w-100" onclick="removeFavoriteFromForm()">Remove Favorite</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Display -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div id="results" class="card results-card">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Response</h5>
                    <button class="btn btn-sm btn-secondary" onclick="clearResults()">Clear</button>
                </div>
                <div class="card-body">
                    <pre id="resultContent" class="mb-0 results-content"></pre>
                </div>
            </div>
        </div>
    </div>
</div>
