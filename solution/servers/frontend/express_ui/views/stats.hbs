    {{> navbar}}
    
    <div class="header-gradient primary">
        <div class="container">
            <h1>📊 {{title}}</h1>
            {{#if stats.calculatedAt}}
            <p>Last updated: {{stats.calculatedAt}}</p>
            {{/if}}
        </div>
    </div>

    <div class="container py-4">
        {{#if stats}}
        <div class="stats-grid">
            <div class="stat-card anime">
                <div class="stat-icon">🎬</div>
                <div class="stat-value">{{stats.totalAnime}}</div>
                <div class="stat-label">Total Anime</div>
            </div>

            <div class="stat-card profiles">
                <div class="stat-icon">👥</div>
                <div class="stat-value">{{stats.totalProfiles}}</div>
                <div class="stat-label">Total Users</div>
            </div>

            <div class="stat-card ratings">
                <div class="stat-icon">⭐</div>
                <div class="stat-value">{{stats.totalRatings}}</div>
                <div class="stat-label">Total Ratings</div>
            </div>

            <div class="stat-card favorites">
                <div class="stat-icon">❤️</div>
                <div class="stat-value">{{stats.totalFavorites}}</div>
                <div class="stat-label">Total Favorites</div>
            </div>
        </div>
        {{else}}
        <div class="not-found">
            <h2>📊 No Statistics Available</h2>
            <p>Statistics could not be loaded at this time.</p>
        </div>
        {{/if}}

        <div class="text-center mt-4">
            <a href="/stats/global" class="btn btn-outline-primary">🔄 Refresh Stats</a>
        </div>
    </div>