    {{> navbar}}
    
    <div class="header-gradient primary">
        <div class="container">
            <h1>📖 Anime Details</h1>
        </div>
    </div>

    <div class="container py-4">
        {{#if anime}}
        <!-- Titles Section -->
        <div class="mb-4">
            <h1 class="text-primary mb-2">{{anime.title}}</h1>
            {{#if anime.titleEnglish}}
            <p class="text-muted mb-1 subtitle-text">{{anime.titleEnglish}}</p>
            {{/if}}
            {{#if anime.titleJapanese}}
            <p class="text-muted mb-3 subtitle-text">{{anime.titleJapanese}}</p>
            {{/if}}
        </div>

        <!-- Main Content with Image and Details -->
        <div class="row">
            <!-- Image Column -->
            <div class="col-lg-4 col-md-5 mb-4">
                {{#if anime.imageUrl}}
                <img src="{{anime.imageUrl}}" alt="{{anime.title}}" class="img-fluid rounded shadow-lg w-100 mb-3 anime-detail-image" 
                     onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                {{else}}
                <div class="text-center p-5 border rounded bg-light shadow mb-3 anime-detail-image-fallback">
                    <div class="display-1">🎬</div>
                </div>
                {{/if}}

                <!-- Stats Box -->
                <a href="/anime/stats/{{#if anime.malId}}{{anime.malId}}{{else}}{{anime.mal_id}}{{/if}}" class="text-decoration-none">
                    <div class="card shadow-sm anime-detail-stats-card" data-anime-stats-id="{{#if anime.malId}}{{anime.malId}}{{else}}{{anime.mal_id}}{{/if}}">
                        <div class="card-body">
                            <h5 class="card-title text-center mb-3">📊 Statistics</h5>
                            <div class="d-flex flex-column gap-2">
                                {{#if anime.score}}
                                <div class="d-flex justify-content-between align-items-center p-2 rounded anime-stats-score">
                                    <span class="text-muted">Score</span>
                                    <span class="fw-bold text-primary">⭐ {{anime.score}}/10</span>
                                </div>
                                {{/if}}
                                {{#if anime.rank}}
                                <div class="d-flex justify-content-between align-items-center p-2 rounded anime-stats-rank">
                                    <span class="text-muted">Rank</span>
                                    <span class="fw-bold text-success">#{{anime.rank}}</span>
                                </div>
                                {{/if}}
                                {{#if anime.favorites}}
                                <div class="d-flex justify-content-between align-items-center p-2 rounded anime-stats-favorites">
                                    <span class="text-muted">Favorites</span>
                                    <span class="fw-bold text-danger">❤️ {{anime.favorites}}</span>
                                </div>
                                {{/if}}
                            </div>
                            <div class="text-center mt-3">
                                <small class="text-muted">Click to view detailed stats</small>
                            </div>
                        </div>
                    </div>
                </a>

                <!-- Recommendations Button -->
                <a href="/recommendations/{{#if anime.malId}}{{anime.malId}}{{else}}{{anime.mal_id}}{{/if}}" class="btn btn-primary w-100 mt-3">
                    🎯 View Recommendations
                </a>
            </div>

            <!-- Details Column -->
            <div class="col-lg-8 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body">
                        {{#if anime.synopsis}}
                        <div class="mb-4">
                            <h4 class="border-bottom pb-2">Synopsis</h4>
                            <p class="text-justify">{{anime.synopsis}}</p>
                        </div>
                        {{/if}}

                        <div class="mb-4">
                            <h4 class="border-bottom pb-2">Information</h4>
                            <div class="row">
                                {{#if anime.malId}}
                                <div class="col-md-6 mb-2">
                                    <strong>Anime ID:</strong> {{anime.malId}}
                                </div>
                                {{/if}}
                                {{#if anime.type}}
                                <div class="col-md-6 mb-2">
                                    <strong>Type:</strong> {{anime.type}}
                                </div>
                                {{/if}}
                                {{#if anime.episodes}}
                                <div class="col-md-6 mb-2">
                                    <strong>Episodes:</strong> {{anime.episodes}}
                                </div>
                                {{/if}}
                                {{#if anime.status}}
                                <div class="col-md-6 mb-2">
                                    <strong>Status:</strong> {{anime.status}}
                                </div>
                                {{/if}}
                                {{#if anime.airedFrom}}
                                <div class="col-md-6 mb-2">
                                    <strong>Aired:</strong> {{anime.airedFrom}}{{#if anime.airedTo}} to {{anime.airedTo}}{{/if}}
                                </div>
                                {{/if}}
                                {{#if anime.season}}
                                <div class="col-md-6 mb-2">
                                    <strong>Season:</strong> {{anime.season}}{{#if anime.year}} {{anime.year}}{{/if}}
                                </div>
                                {{/if}}
                                {{#if anime.duration}}
                                <div class="col-md-6 mb-2">
                                    <strong>Duration:</strong> {{anime.duration}}
                                </div>
                                {{/if}}
                                {{#if anime.rating}}
                                <div class="col-md-6 mb-2">
                                    <strong>Rating:</strong> {{anime.rating}}
                                </div>
                                {{/if}}
                                {{#if anime.source}}
                                <div class="col-md-6 mb-2">
                                    <strong>Source:</strong> {{anime.source}}
                                </div>
                                {{/if}}
                                {{#if anime.genres}}
                                <div class="col-12 mb-2">
                                    <strong>Genres:</strong> {{formatList anime.genres}}
                                </div>
                                {{/if}}
                                {{#if anime.themes}}
                                <div class="col-12 mb-2">
                                    <strong>Themes:</strong> {{formatList anime.themes}}
                                </div>
                                {{/if}}
                                {{#if anime.demographics}}
                                <div class="col-12 mb-2">
                                    <strong>Demographics:</strong> {{formatList anime.demographics}}
                                </div>
                                {{/if}}
                                {{#if anime.studios}}
                                <div class="col-12 mb-2">
                                    <strong>Studios:</strong> {{formatList anime.studios}}
                                </div>
                                {{/if}}
                                {{#if anime.producers}}
                                <div class="col-12 mb-2">
                                    <strong>Producers:</strong> {{formatList anime.producers}}
                                </div>
                                {{/if}}
                                {{#if anime.licensors}}
                                <div class="col-12 mb-2">
                                    <strong>Licensors:</strong> {{formatList anime.licensors}}
                                </div>
                                {{/if}}
                                {{#if anime.scoredBy}}
                                <div class="col-md-6 mb-2">
                                    <strong>Scored By:</strong> {{anime.scoredBy}} users
                                </div>
                                {{/if}}
                            </div>
                        </div>

                        {{#if anime.background}}
                        <div class="mb-4">
                            <h4 class="border-bottom pb-2">Background</h4>
                            <p class="text-justify">{{anime.background}}</p>
                        </div>
                        {{/if}}
                    </div>
                </div>
            </div>

            <!-- Characters Section -->
            {{#if charactersList}}
            {{#if charactersList.length}}
            <div class="mt-5">
                <h3 class="mb-3">Characters (Top 20 by Favorites)</h3>
                <div class="anime-scroll-container">
                    <div class="anime-scroll-wrapper">
                        {{#each charactersList}}
                        <div class="anime-scroll-card">
                            <div class="card anime-card clickable h-100" data-character-id="{{this.character_mal_id}}">
                                {{#if this.image_url}}
                                <img src="{{this.image_url}}" alt="{{this.name}}" class="card-img-top anime-card-image" 
                                     onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                                {{else}}
                                <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" 
                                     alt="{{this.name}}" class="card-img-top anime-card-image">
                                {{/if}}
                                <div class="card-body">
                                    <h6 class="card-title text-primary">{{this.name}}</h6>
                                    {{#if this.role}}
                                    <p class="card-text small text-muted mb-1"><strong>Role:</strong> {{this.role}}</p>
                                    {{/if}}
                                    {{#if this.name_kanji}}
                                    <p class="card-text small text-muted mb-1"><strong>Kanji:</strong> {{this.name_kanji}}</p>
                                    {{/if}}
                                    {{#if this.favorites}}
                                    <p class="card-text small text-muted mb-1">
                                        <strong>Favorites:</strong> 
                                        <span class="badge bg-danger">❤️ {{this.favorites}}</span>
                                    </p>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
            {{/if}}
            {{/if}}

            <!-- People Section -->
            {{#if peopleList}}
            {{#if peopleList.length}}
            <div class="mt-5">
                <h3 class="mb-3">Staff & Voice Actors (Top 20 by Favorites)</h3>
                <div class="anime-scroll-container">
                    <div class="anime-scroll-wrapper">
                        {{#each peopleList}}
                        <div class="anime-scroll-card">
                            <div class="card anime-card clickable h-100" data-person-id="{{this.person_mal_id}}">
                                {{#if this.image_url}}
                                <img src="{{this.image_url}}" alt="{{this.name}}" class="card-img-top anime-card-image" 
                                     onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                                {{else}}
                                <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" 
                                     alt="{{this.name}}" class="card-img-top anime-card-image">
                                {{/if}}
                                <div class="card-body">
                                    <h6 class="card-title text-primary">{{this.name}}</h6>
                                    {{#if this.language}}
                                    <p class="card-text small text-muted mb-1"><strong>Language:</strong> {{this.language}}</p>
                                    {{/if}}
                                    {{#if this.role}}
                                    <p class="card-text small text-muted mb-1"><strong>Role:</strong> {{this.role}}</p>
                                    {{/if}}
                                    {{#if this.favorites}}
                                    <p class="card-text small text-muted mb-1">
                                        <strong>Favorites:</strong> 
                                        <span class="badge bg-danger">❤️ {{this.favorites}}</span>
                                    </p>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
            {{/if}}
            {{/if}}

            <div class="mt-4">
                <a href="#" onclick="history.back(); return false;" class="btn btn-outline-primary">← Go Back</a>
            </div>
        </div>
        {{else}}
        <div class="alert alert-warning">
            <h4 class="alert-heading">Anime Not Found</h4>
            <p>The requested anime could not be found.</p>
            <hr>
            <div class="d-flex gap-2">
                <a href="#" onclick="history.back(); return false;" class="btn btn-primary">← Go Back</a>
            </div>
        {{/if}}
    </div>