{{> navbar}}

<div class="header-gradient primary">
    <div class="container">
        <h1>🔍 Search Anime</h1>
    </div>
</div>

<div class="container py-4">
        <!-- Form di ricerca con filtri -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">🎯 Search Filters</h5>
            </div>
            <div class="card-body">
                <form action="/anime/search" method="GET" id="searchForm" data-show-warning="{{showWarning}}">
                    <div class="row g-2 align-items-end">
                        <!-- Ricerca per titolo -->
                        <div class="col-md-3">
                            <label for="title" class="form-label form-label-sm mb-1">Title</label>
                            <input type="text" name="title" id="title" class="form-control form-control-sm" 
                                   placeholder="Search anime..." 
                                   value="{{filters.title}}">
                        </div>

                        <!-- Filtro per genere - Dropdown con checkboxes -->
                        <div class="col-md-3">
                            <label class="form-label form-label-sm mb-1">Genres</label>
                            <div class="dropdown w-100">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 d-flex justify-content-between align-items-center" type="button" id="genreDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span id="genreButtonText">Select...</span>
                                </button>
                                <ul class="dropdown-menu genre-dropdown w-100" aria-labelledby="genreDropdown">
                                    {{#each availableGenres}}
                                    <li>
                                        <div class="dropdown-item p-0">
                                            <div class="form-check m-0 p-2">
                                                <input class="form-check-input genre-checkbox" type="checkbox" value="{{this}}" id="genre-{{@index}}" 
                                                    {{#if (includes ../selectedGenres this)}}checked{{/if}}>
                                                <label class="form-check-label w-100 d-block clickable" for="genre-{{@index}}">
                                                    {{this}}
                                                </label>
                                            </div>
                                        </div>
                                    </li>
                                    {{/each}}
                                </ul>
                            </div>
                            <!-- Hidden inputs per form submission -->
                            <div id="selectedGenresContainer">
                                {{#each selectedGenres}}
                                <input type="hidden" name="genres" value="{{this}}">
                                {{/each}}
                            </div>
                        </div>

                        <!-- Filtro per score minimo -->
                        <div class="col-md-2">
                            <label for="minScore" class="form-label form-label-sm mb-1">Min Score</label>
                            <input type="number" name="minScore" id="minScore" class="form-control form-control-sm" 
                                   placeholder="e.g. 7.5" step="0.1" min="0" max="10"
                                   value="{{filters.minScore}}">
                        </div>

                        <!-- Top rated limit -->
                        <div class="col-md-2">
                            <label for="limit" class="form-label form-label-sm mb-1">Top Limit</label>
                            <input type="number" name="limit" id="limit" class="form-control form-control-sm" 
                                   placeholder="e.g. 50" min="1" max="10000"
                                   value="{{filters.limit}}">
                            <small class="text-muted">Max: 10000</small>
                        </div>

                        <!-- Bottoni -->
                        <div class="col-md-2">
                            <label class="form-label form-label-sm mb-1 invisible">Actions</label>
                            <div class="d-flex gap-1">
                                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                                    Search
                                </button>
                                <a href="/anime/search" class="btn btn-outline-secondary btn-sm flex-fill">
                                    Clear
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Badge display per generi selezionati -->
                    <div id="selectedGenresBadges" class="mt-2"></div>
                </form>
            </div>
        </div>

        <!-- Error Message -->
        {{#if error}}
        <div class="alert alert-warning" role="alert">
            <strong>⚠️ Warning:</strong> {{error}}
        </div>
        {{/if}}

        <!-- Risultati -->
        {{#if results}}
            {{#if results.length}}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0">
                        Search Results 
                        {{#if pagination}}
                            <span class="badge bg-primary">{{pagination.totalItems}} found</span>
                        {{else}}
                            <span class="badge bg-primary">{{results.length}} found</span>
                        {{/if}}
                    </h2>
                    
                    <!-- Filtri attivi -->
                    <div class="text-end">
                        {{#if filters.title}}
                        <span class="badge bg-info">Title: {{filters.title}}</span>
                        {{/if}}
                        {{#each selectedGenres}}
                        <span class="badge bg-success">Genre: {{this}}</span>
                        {{/each}}
                        {{#if filters.minScore}}
                        <span class="badge bg-warning">Score ≥ {{filters.minScore}}</span>
                        {{/if}}
                        {{#if filters.limit}}
                        <span class="badge bg-danger">Top {{filters.limit}}</span>
                        {{/if}}
                    </div>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                    {{#each results}}
                    <div class="col">
                        <div class="card anime-card clickable h-100" data-anime-id="{{this.mal_id}}">
                            {{#if this.imageUrl}}
                            <img src="{{this.imageUrl}}" alt="{{this.title}}" class="card-img-top anime-card-image" 
                                 onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                            {{else}}
                            <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" 
                                 alt="{{this.title}}" class="card-img-top anime-card-image">
                            {{/if}}
                            <div class="card-body">
                                <h6 class="card-title text-primary">{{this.title}}</h6>
                                {{#if this.type}}
                                <p class="card-text small text-muted mb-1"><strong>Type:</strong> {{this.type}}</p>
                                {{/if}}
                                {{#if this.episodes}}
                                <p class="card-text small text-muted mb-1"><strong>Episodes:</strong> {{this.episodes}}</p>
                                {{/if}}
                                {{#if this.score}}
                                <p class="card-text small text-muted mb-1">
                                    <strong>Score:</strong> 
                                    <span class="badge {{#if (gt this.score 8)}}bg-success{{else if (gt this.score 7)}}bg-info{{else}}bg-secondary{{/if}}">
                                        ⭐ {{this.score}}
                                    </span>
                                </p>
                                {{/if}}
                                {{#if this.genres}}
                                <p class="card-text small text-muted mb-1"><strong>Genres:</strong> {{formatList this.genres}}</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>

                {{> pagination}}
            {{else}}
                <div class="text-center py-5">
                    <h2 class="text-muted">😕 No Results Found</h2>
                    <p class="text-muted">Try adjusting your filters or search terms</p>
                </div>
            {{/if}}
        {{else}}
            <div class="text-center py-5">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" fill="currentColor" class="bi bi-search text-muted" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                </div>
                <h3 class="text-muted">Start Your Search</h3>
                <p class="text-muted">Use the filters above to find anime by title, genre, or rating</p>
                <div class="mt-4">
                    <p class="text-muted small">💡 <strong>Tips:</strong></p>
                    <ul class="list-unstyled text-muted small">
                        <li>• Search by title only for broad results</li>
                        <li>• Combine title + genre for specific anime</li>
                        <li>• Use minimum score to find highly rated anime</li>
                        <li>• Set top rated limit to see the best anime</li>
                    </ul>
                </div>
            </div>
        {{/if}}
    </div>
</div>
