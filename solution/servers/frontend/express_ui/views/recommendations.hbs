  {{> navbar}}
  
  {{#if anime}}
  <div class="header-gradient green">
    <div class="container">
      <h1>💡 Recommendations</h1>
      <p>{{anime.title}}</p>
    </div>
  </div>

  <div class="container py-4">

    {{#if recommendations}}
    {{#if recommendations.length}}
    <h3 class="mb-4">Found {{#if pagination}}{{pagination.totalItems}}{{else}}{{recommendations.length}}{{/if}}
      Recommendations</h3>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
      {{#each recommendations}}
      <div class="col">
        <div class="card anime-card h-100">
          {{#if this.details}}
          <a href="/anime/{{this.details.mal_id}}">
            {{#if this.details.image_url}}
            <img src="{{this.details.image_url}}" alt="{{this.details.title}}" class="card-img-top"
              style="height:300px;object-fit:cover"
              onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
            {{else}}
            <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" alt="{{this.details.title}}"
              class="card-img-top" style="height:300px;object-fit:cover">
            {{/if}}
            <div class="card-body">
              <h6 class="card-title text-primary">{{this.details.title}}</h6>
              <p class="card-text small text-muted mb-1"><strong>MAL ID:</strong> {{this.details.mal_id}}</p>
              {{#if this.details.type}}
              <p class="card-text small text-muted mb-1"><strong>Type:</strong> {{this.details.type}}</p>
              {{/if}}
              {{#if this.details.episodes}}
              <p class="card-text small text-muted mb-1"><strong>Episodes:</strong> {{this.details.episodes}}</p>
              {{/if}}
              {{#if this.details.score}}
              <p class="card-text small text-muted mb-1"><strong>Score:</strong> ⭐ {{this.details.score}}</p>
              {{/if}}
              {{#if this.details.genres}}
              <p class="card-text small text-muted mb-1"><strong>Genre:</strong> {{formatList this.details.genres}}</p>
              {{/if}}
            </div>
          </a>
          {{else}}
          <div class="card-body">
            <h6 class="card-title text-primary">Anime #{{this.recommendation_mal_id}}</h6>
            <p class="card-text small text-muted mb-1"><strong>MAL ID:</strong> {{this.recommendation_mal_id}}</p>
            <p class="card-text small text-muted">(Details not available)</p>
            <a href="/anime/{{this.recommendation_mal_id}}" class="btn btn-sm btn-outline-primary mt-2">View Details</a>
          </div>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>

    {{> pagination}}
    {{else}}
    <div class="text-center py-5">
      <div class="mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-emoji-frown text-muted" viewBox="0 0 16 16">
          <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
          <path d="M4.285 12.433a.5.5 0 0 0 .683-.183A3.498 3.498 0 0 1 8 10.5c1.295 0 2.426.703 3.032 1.75a.5.5 0 0 0 .866-.5A4.498 4.498 0 0 0 8 9.5a4.5 4.5 0 0 0-3.898 2.25.5.5 0 0 0 .183.683zM7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5zm4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5z"/>
        </svg>
      </div>
      <h2 class="text-muted">No Recommendations Available</h2>
      <p class="text-muted">There are currently no recommendations for this anime.</p>
      <p class="text-muted small">Check back later as recommendations are added over time.</p>
    </div>
    {{/if}}
    {{else}}
    <div class="text-center py-5">
      <div class="mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-emoji-frown text-muted" viewBox="0 0 16 16">
          <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
          <path d="M4.285 12.433a.5.5 0 0 0 .683-.183A3.498 3.498 0 0 1 8 10.5c1.295 0 2.426.703 3.032 1.75a.5.5 0 0 0 .866-.5A4.498 4.498 0 0 0 8 9.5a4.5 4.5 0 0 0-3.898 2.25.5.5 0 0 0 .183.683zM7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5zm4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5z"/>
        </svg>
      </div>
      <h2 class="text-muted">No Recommendations Available</h2>
      <p class="text-muted">There are currently no recommendations for this anime.</p>
      <p class="text-muted small">Check back later as recommendations are added over time.</p>
    </div>
    {{/if}}

    <div class="text-center mt-4">
      <a href="/anime/{{anime.mal_id}}" class="btn btn-outline-primary">← Back to Anime</a>
    </div>
  </div>
  {{else}}
  <div class="header-gradient green">
    <div class="container">
      <h1>💡 Recommendations</h1>
      <p>Anime not found</p>
    </div>
  </div>
  <div class="container py-4">
    <div class="not-found">
      <h2>⚠️ Anime Not Found</h2>
      <p>The anime you're looking for could not be found.</p>
    </div>
  </div>
  {{/if}}