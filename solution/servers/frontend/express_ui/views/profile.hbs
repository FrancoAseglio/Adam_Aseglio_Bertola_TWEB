    {{> navbar}}

    <div class="header-gradient">
        <div class="container">
            <h1>👤 {{username}}</h1>
            <p>User Profile</p>
        </div>
    </div>

    <div class="container mb-5">
        <!-- Stats Row -->
        {{#if profile}}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm profile-stats-clickable" onclick="window.location.href='/stats/user/{{username}}'">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0 text-white">📊 User Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-sm-6 col-lg-3">
                                <div class="stat-card">
                                    <div class="stat-value">{{profile.completed}}</div>
                                    <div class="stat-label">✓ Completed</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="stat-card cyan">
                                    <div class="stat-value">{{profile.watching}}</div>
                                    <div class="stat-label">▶ Watching</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="stat-card sunset">
                                    <div class="stat-value">{{profile.userRatings}}</div>
                                    <div class="stat-label">⭐ Ratings</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="stat-card" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);">
                                    <div class="stat-value">{{profile.userFavorites}}</div>
                                    <div class="stat-label">❤ Favorites</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

        <!-- Favorites Section -->
        {{#if favorites}}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">❤️ Favorites (Top {{favorites.length}})</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            {{#each favorites}}
                            <div class="col-md-6 col-lg-4 col-xl-3">
                                <div class="card anime-card h-100 hover-lift">
                                    {{#if this.details}}
                                        {{#if (eq this.fav_type "anime")}}
                                            <!-- Anime Image -->
                                            {{#if this.details.image_url}}
                                            <a href="/anime/{{this.id}}">
                                                <img src="{{this.details.image_url}}"
                                                     alt="{{this.details.title}}"
                                                     class="card-img-top"
                                                     style="height: 280px; object-fit: cover;">
                                            </a>
                                            {{/if}}

                                            <div class="card-body">
                                                <a href="/anime/{{this.id}}" class="text-decoration-none">
                                                    <h6 class="card-title mb-2" style="color: var(--primary-color); min-height: 2.5em;">
                                                        🎬 {{this.details.title}}
                                                    </h6>
                                                </a>
                                                <p class="mb-1 text-muted small"><strong>Type:</strong> {{this.details.type}}</p>
                                                {{#if this.details.score}}
                                                <p class="mb-0"><span class="badge bg-warning text-dark">⭐ {{this.details.score}}</span></p>
                                                {{/if}}
                                            </div>
                                        {{else if (eq this.fav_type "character")}}
                                            <!-- Character Image -->
                                            {{#if this.details.image_url}}
                                            <a href="/characters/{{this.id}}">
                                                <img src="{{this.details.image_url}}"
                                                     alt="{{this.details.name}}"
                                                     class="card-img-top"
                                                     style="height: 280px; object-fit: cover;">
                                            </a>
                                            {{/if}}

                                            <div class="card-body">
                                                <a href="/characters/{{this.id}}" class="text-decoration-none">
                                                    <h6 class="card-title mb-2" style="color: var(--primary-color); min-height: 2.5em;">
                                                        👤 {{this.details.name}}
                                                    </h6>
                                                </a>
                                                <p class="mb-1 text-muted small"><strong>Type:</strong> Character</p>
                                                {{#if this.details.favorites}}
                                                <p class="mb-0"><span class="badge bg-danger">❤️ {{this.details.favorites}} favorites</span></p>
                                                {{/if}}
                                            </div>
                                        {{else if (eq this.fav_type "people")}}
                                            <!-- Person Image -->
                                            {{#if this.details.image_url}}
                                            <a href="/people/{{this.id}}">
                                                <img src="{{this.details.image_url}}"
                                                     alt="{{#if this.details.name}}{{this.details.name}}{{else}}{{this.details.givenName}} {{this.details.familyName}}{{/if}}"
                                                     class="card-img-top"
                                                     style="height: 280px; object-fit: cover;">
                                            </a>
                                            {{/if}}

                                            <div class="card-body">
                                                <a href="/people/{{this.id}}" class="text-decoration-none">
                                                    <h6 class="card-title mb-2" style="color: var(--primary-color); min-height: 2.5em;">
                                                        {{#if this.details.name}}{{this.details.name}}{{else}}{{this.details.givenName}} {{this.details.familyName}}{{/if}}
                                                    </h6>
                                                </a>
                                                <p class="mb-1 text-muted small"><strong>Type:</strong> Person</p>
                                                {{#if this.details.favorites}}
                                                <p class="mb-0"><span class="badge bg-danger">❤️ {{this.details.favorites}} favorites</span></p>
                                                {{/if}}
                                            </div>
                                        {{/if}}
                                    {{else}}
                                        <div class="card-body">
                                            <h6 class="mb-2">ID: {{this.id}}</h6>
                                            <p class="mb-0 text-muted small"><strong>Type:</strong> {{this.fav_type}}</p>
                                        </div>
                                    {{/if}}
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        <div class="card-footer bg-transparent border-top-0 text-center pt-3">
                            <a href="/favorites/{{username}}" class="btn btn-success">
                                ❤️ View All Favorites →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

        <!-- Recent Ratings Section -->
        {{#if ratings}}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0" style="color: white !important;">⭐ Recent Ratings (Last {{ratings.length}})</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            {{#each ratings}}
                            <div class="col-md-6 col-lg-4 col-xl-3">
                                <div class="card anime-card h-100 hover-lift">
                                    {{#if this.animeDetails}}
                                        <!-- Cover Image -->
                                        {{#if this.animeDetails.image_url}}
                                        <a href="/anime/{{this.anime_id}}">
                                            <img src="{{this.animeDetails.image_url}}"
                                                 alt="{{this.animeDetails.title}}"
                                                 class="card-img-top"
                                                 style="height: 280px; object-fit: cover;">
                                        </a>
                                        {{/if}}

                                        <div class="card-body">
                                            <!-- Clickable Anime Title -->
                                            <a href="/anime/{{this.anime_id}}" class="text-decoration-none">
                                                <h6 class="card-title mb-2" style="color: var(--primary-color); min-height: 2.5em;">
                                                    {{this.animeDetails.title}}
                                                </h6>
                                            </a>

                                            <!-- Rating Score -->
                                            <div class="mb-2 d-flex justify-content-between align-items-center">
                                                <span class="badge" style="background: var(--gradient-orange); font-size: 0.9rem; padding: 0.4rem 0.8rem;">
                                                    ⭐ {{this.score}}/10
                                                </span>
                                                {{#if this.animeDetails.type}}
                                                <span class="type-badge">{{this.animeDetails.type}}</span>
                                                {{/if}}
                                            </div>

                                            <!-- Additional Info -->
                                            {{#if this.num_watched_episodes}}
                                            <p class="mb-0 text-muted small">
                                                📺 Watched: {{this.num_watched_episodes}}
                                                {{#if this.animeDetails.episodes}}/ {{this.animeDetails.episodes}}{{/if}} episodes
                                            </p>
                                            {{/if}}
                                        </div>
                                    {{else}}
                                        <div class="card-body">
                                            <h6 class="mb-2">Anime ID: {{this.anime_id}}</h6>
                                            <div class="mb-0">
                                                <span class="badge" style="background: var(--gradient-orange);">⭐ {{this.score}}/10</span>
                                            </div>
                                        </div>
                                    {{/if}}
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        <div class="card-footer bg-transparent border-top-0 text-center pt-3">
                            <a href="/ratings/{{username}}" class="btn btn-warning">
                                ⭐ View All Ratings →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

        <div class="mt-4">
            <a href="/profile" class="btn btn-outline-primary">← Back to Search</a>
        </div>
    </div>