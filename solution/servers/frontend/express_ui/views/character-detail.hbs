    {{> navbar}}

    {{#if character}}
    <div class="header-gradient cyan">
        <div class="container">
            <h1>{{character.name}}</h1>
            {{#if character.name_kanji}}
                <p>{{character.name_kanji}}</p>
            {{/if}}
            {{#if character.nicknames}}
                <p class="mb-0"><em>Also known as: {{character.nicknames}}</em></p>
            {{/if}}
        </div>
    </div>

<div class="container py-4">
        <div class="row g-4">
            <!-- Character Image -->
            <div class="col-md-4">
                <div class="character-detail-image">
                    {{#if character.image_url}}
                        <img src="{{character.image_url}}" alt="{{character.name}}" onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                    {{else}}
                        <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png" alt="No image available">
                    {{/if}}
                </div>

                {{#if character.favorites}}
                    <div class="card mt-3 text-center border-0 shadow-sm">
                        <div class="card-body">
                            <div class="fs-1">❤️</div>
                            <div class="stat-value character-favorites-value">{{character.favorites}}</div>
                            <div class="stat-label character-favorites-label">Favorites</div>
                        </div>
                    </div>
                {{/if}}
            </div>

            <!-- Character Details -->
            <div class="col-md-8">
                <div class="info-card-detail">
                    <h3>Character Information</h3>

                    <div class="info-grid">
                        <div class="info-label">Character ID:</div>
                        <div class="info-value">{{character.character_mal_id}}</div>

                        <div class="info-label">Name:</div>
                        <div class="info-value">{{character.name}}</div>

                        {{#if character.roles}}
                        {{#if character.roles.length}}
                        <div class="info-label">Role(s):</div>
                        <div class="info-value">
                            {{#each character.roles}}
                            <span class="badge {{#if (eq this 'Main')}}bg-warning text-dark{{else}}bg-info{{/if}} me-1">
                                {{this}}
                            </span>
                            {{/each}}
                        </div>
                        {{/if}}
                        {{/if}}

                        {{#if character.name_kanji}}
                        <div class="info-label">Name Kanji:</div>
                        <div class="info-value">{{character.name_kanji}}</div>
                        {{/if}}

                        {{#if character.nicknames}}
                        <div class="info-label">Nicknames:</div>
                        <div class="info-value">{{character.nicknames}}</div>
                        {{/if}}

                        {{#if character.image_url}}
                        <div class="info-label">Image URL:</div>
                        <div class="info-value">{{character.image_url}}</div>
                        {{/if}}
                    </div>
                </div>

                {{#if character.about}}
                <div class="info-card-detail">
                    <h3>About</h3>
                    <div class="about-fields">
                        {{{aboutBold character.about}}}
                    </div>
                </div>
                {{/if}}
            </div>
        </div>

        {{#if animeList}}
        {{#if animeList.length}}
        <div class="mt-5">
            <h3 class="mb-3">Anime Appearances</h3>
            <div class="anime-scroll-container">
                <div class="anime-scroll-wrapper">
                    {{#each animeList}}
                    <div class="anime-scroll-card">
                        <div class="card anime-card h-100 clickable" onclick="window.location.href='/anime/{{this.mal_id}}'">
                            {{#if this.image_url}}
                            <img src="{{this.image_url}}" alt="{{this.title}}" class="card-img-top character-card-image-280"
                                 onerror="this.src='https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png'">
                            {{else}}
                            <img src="https://cdn.myanimelist.net/img/sp/icon/apple-touch-icon-256.png"
                                 alt="{{this.title}}" class="card-img-top character-card-image-280">
                            {{/if}}
                            <div class="card-body">
                                <h6 class="card-title text-primary">{{this.title}}</h6>
                                {{#if this.role}}
                                <p class="card-text small text-muted mb-1">
                                    <strong>Role:</strong>
                                    <span class="badge {{#if (eq this.role 'Main')}}bg-warning text-dark{{else}}bg-info{{/if}}">
                                        {{this.role}}
                                    </span>
                                </p>
                                {{/if}}
                                {{#if this.type}}
                                <p class="card-text small text-muted mb-1"><strong>Type:</strong> {{this.type}}</p>
                                {{/if}}
                                {{#if this.episodes}}
                                <p class="card-text small text-muted mb-1"><strong>Episodes:</strong> {{this.episodes}}</p>
                                {{/if}}
                                {{#if this.score}}
                                <p class="card-text small text-muted mb-1">
                                    <strong>Score:</strong>
                                    <span class="badge {{#if (gt this.score 8)}}bg-success{{else if (gt this.score 7)}}bg-info{{else}}bg-secondary{{/if}}">
                                        ⭐ {{this.score}}
                                    </span>
                                </p>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
        {{/if}}
        {{/if}}

        <div class="mt-4">
            <a href="#" onclick="history.back(); return false;" class="btn btn-outline-primary">← Go Back</a>
        </div>
    </div>
    {{else}}
    <div class="container py-5">
        <div class="not-found">
            <h2>😕 Character Not Found</h2>
            <p>The character you're looking for doesn't exist or couldn't be loaded.</p>
        </div>
        <div class="mt-4">
            <a href="#" onclick="history.back(); return false;" class="btn btn-outline-primary">← Go Back</a>
        </div>
    </div>
    {{/if}}