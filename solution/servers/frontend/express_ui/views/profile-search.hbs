    {{> navbar}}
    
    <div class="header-gradient green">
        <div class="container">
            <h1>👤 User Profiles</h1>
            <p>Search and explore user profiles</p>
        </div>
    </div>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-lg">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4" style="font-size: 4rem;">🔍</div>
                        <h3 class="mb-4">Search User Profile</h3>
                        <p class="text-muted mb-4">Enter a username to view their anime profile, favorites, and ratings</p>
                        
                        <div class="mb-4">
                            <input type="text" 
                                   class="form-control form-control-lg text-center" 
                                   id="username" 
                                   placeholder="Enter username (e.g., CKK2)"
                                   style="border-radius: 50px; font-size: 1.1rem;">
                        </div>
                        
                        <button class="btn btn-success btn-lg w-100" 
                                style="border-radius: 50px; padding: 0.75rem 2rem;"
                                onclick="getUserProfile()">
                            <i class="bi bi-search me-2"></i>
                            View Profile
                        </button>
                        
                        <div class="mt-4">
                            <p class="text-muted small mb-2">💡 <strong>Tip:</strong></p>
                            <p class="text-muted small">Search for existing users to view their anime favorites and ratings!</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function getUserProfile() {
            const username = document.getElementById('username').value.trim();
            if (!username) {
                alert('Please enter a username');
                return;
            }
            window.location.href = `/profile/${username}`;
        }
        
        // Allow Enter key to submit
        document.getElementById('username').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                getUserProfile();
            }
        });
    </script>