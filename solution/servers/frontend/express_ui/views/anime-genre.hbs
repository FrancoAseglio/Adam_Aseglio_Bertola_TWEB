    {{> navbar}}
    
    <div class="header-gradient orange">
        <div class="container">
            <h1>🎭 {{title}}</h1>
            <p>Anime in the {{genre}} genre</p>
        </div>
    </div>

    <div class="container py-4">
        {{#if results}}
            {{#if results.length}}
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">{{genre}} Anime ({{results.length}} found)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            {{#each results}}
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 hover-lift clickable" data-anime-id="{{this.animeMalId}}">
                                    <div class="card-body">
                                        <h6 class="card-title">{{this.title}}</h6>
                                        <p class="card-text text-muted small mb-1">ID: {{this.animeMalId}}</p>
                                        {{#if this.type}}
                                        <p class="card-text text-muted small mb-1">Type: {{this.type}}</p>
                                        {{/if}}
                                        {{#if this.episodes}}
                                        <p class="card-text text-muted small mb-1">Episodes: {{this.episodes}}</p>
                                        {{/if}}
                                        {{#if this.score}}
                                        <p class="card-text mb-0">
                                            <span class="badge bg-success">⭐ {{this.score}}</span>
                                        </p>
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            {{else}}
                <div class="alert alert-info">
                    <h5>No Results Found</h5>
                    <p class="mb-0">No anime found in the "{{genre}}" genre.</p>
                </div>
            {{/if}}
        {{else}}
            <div class="alert alert-warning">
                <p class="mb-0">Unable to load anime for this genre.</p>
            </div>
        {{/if}}

    </div>
    <script src="/javascripts/anime-handlers.js"></script>