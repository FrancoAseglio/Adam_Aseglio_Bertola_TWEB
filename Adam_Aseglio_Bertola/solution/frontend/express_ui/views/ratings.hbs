<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="bg-light">
  {{> navbar}}
  
  <div class="header-gradient orange">
    <div class="container">
      <h1>⭐ {{username}}'s Ratings</h1>
      <p>All anime ratings</p>
    </div>
  </div>

  <div class="container mb-5">
    <div class="row mb-4">
      <div class="col-md-12">
        <div class="alert alert-info">
          <strong>📊 Total Ratings:</strong> {{#if
          pagination}}{{pagination.totalItems}}{{else}}{{ratings.length}}{{/if}}
        </div>
      </div>
    </div>

    {{#if ratings}}
    <div class="row g-4">
      {{#each ratings}}
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        {{#if this.animeDetails}}
        <!-- Anime Card -->
        <div class="card anime-card h-100" style="cursor: pointer;" onclick="window.location.href='/anime/{{this.anime_id}}'">
          {{#if this.animeDetails.image_url}}
          <img src="{{this.animeDetails.image_url}}" alt="{{this.animeDetails.title}}" class="card-img-top" 
               style="height:300px;object-fit:cover" 
               onerror="this.src='https://via.placeholder.com/225x350/667eea/ffffff?text=No+Image'">
          {{else}}
          <img src="https://via.placeholder.com/225x350/667eea/ffffff?text=No+Image" 
               alt="{{this.animeDetails.title}}" class="card-img-top" style="height:300px;object-fit:cover">
          {{/if}}
          <div class="card-body">
            <h6 class="card-title text-primary">{{this.animeDetails.title}}</h6>
            {{#if this.animeDetails.type}}
            <p class="card-text small text-muted mb-1"><strong>Type:</strong> {{this.animeDetails.type}}</p>
            {{/if}}
            {{#if this.animeDetails.episodes}}
            <p class="card-text small text-muted mb-1"><strong>Episodes:</strong> {{this.animeDetails.episodes}}</p>
            {{/if}}
            <p class="card-text small text-muted mb-1">
              <strong>Your Score:</strong> 
              <span class="badge {{#if (gt this.score 8)}}bg-success{{else if (gt this.score 7)}}bg-info{{else if (gt this.score 5)}}bg-warning{{else}}bg-secondary{{/if}}">
                ⭐ {{this.score}}/10
              </span>
            </p>
            {{#if this.num_watched_episodes}}
            <p class="card-text small text-muted mb-1">
              <strong>Watched:</strong> 
              <span class="badge bg-primary">📺 {{this.num_watched_episodes}} eps</span>
            </p>
            {{/if}}
            {{#if this.status}}
            <p class="card-text small text-muted mb-1"><strong>Status:</strong> {{this.status}}</p>
            {{/if}}
            {{#if this.animeDetails.genres}}
            <p class="card-text small text-muted mb-1"><strong>Genres:</strong> {{formatList this.animeDetails.genres}}</p>
            {{/if}}
          </div>
        </div>
        {{else}}
        <!-- Fallback Card -->
        <div class="card anime-card h-100">
          <img src="https://via.placeholder.com/225x350/6c757d/ffffff?text=No+Details" 
               alt="Unknown" class="card-img-top" style="height:300px;object-fit:cover">
          <div class="card-body">
            <h6 class="card-title text-muted">Anime ID: {{this.anime_id}}</h6>
            <p class="card-text small text-muted mb-1">
              <strong>Your Score:</strong> 
              <span class="badge bg-secondary">⭐ {{this.score}}/10</span>
            </p>
            {{#if this.num_watched_episodes}}
            <p class="card-text small text-muted mb-1">
              <strong>Watched:</strong> 
              <span class="badge bg-primary">📺 {{this.num_watched_episodes}} eps</span>
            </p>
            {{/if}}
            <p class="card-text small text-muted">Details not available</p>
          </div>
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="alert alert-warning" role="alert">
      <h4 class="alert-heading">No ratings found!</h4>
      <p>This user hasn't rated any anime yet.</p>
    </div>
    {{/if}}

    {{> pagination baseUrl=(concat "/ratings/" username) urlSeparator="?"}}

    <div class="text-center mt-4">
      <a href="/profile/{{username}}" class="btn btn-outline-primary">👤 View Full Profile</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
