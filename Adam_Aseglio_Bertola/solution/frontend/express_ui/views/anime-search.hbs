<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
    <div class="header-gradient primary">
        <div class="container">
            <h1>🔍 Search Anime</h1>
            <p>Search for anime by title</p>
        </div>
    </div>

    <div class="container py-4">
        <div class="card mb-4">
            <div class="card-body">
                <form action="/anime/search" method="GET">
                    <div class="input-group">
                        <input type="text" name="title" class="form-control" placeholder="Enter anime title..." value="{{query}}" required>
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </form>
            </div>
        </div>

        {{#if query}}
            {{#if results}}
                {{#if results.length}}
                    <h2 class="mb-4">Search Results for "{{query}}" {{#if pagination}}({{pagination.totalItems}} found){{else}}({{results.length}} found){{/if}}</h2>

                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                        {{#each results}}
                        <div class="col">
                            <div class="card h-100 hover-lift" style="cursor: pointer;" onclick="window.location.href='/anime/{{this.animeMalId}}'">
                                {{#if this.imageUrl}}
                                <img src="{{this.imageUrl}}" alt="{{this.title}}" class="card-img-top" style="height:300px;object-fit:cover" onerror="this.src='https://via.placeholder.com/300x450/667eea/ffffff?text=No+Image'">
                                {{else}}
                                <img src="https://via.placeholder.com/300x450/667eea/ffffff?text=No+Image" alt="{{this.title}}" class="card-img-top" style="height:300px;object-fit:cover">
                                {{/if}}
                                <div class="card-body">
                                    <h6 class="card-title text-primary">{{this.title}}</h6>
                                    <p class="card-text small text-muted mb-1"><strong>ID:</strong> {{this.animeMalId}}</p>
                                    {{#if this.type}}
                                    <p class="card-text small text-muted mb-1"><strong>Type:</strong> {{this.type}}</p>
                                    {{/if}}
                                    {{#if this.episodes}}
                                    <p class="card-text small text-muted mb-1"><strong>Episodes:</strong> {{this.episodes}}</p>
                                    {{/if}}
                                    {{#if this.score}}
                                    <p class="card-text small mb-0"><strong>Score:</strong> <span class="badge bg-success">⭐ {{this.score}}</span></p>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>

                    {{> pagination}}
                {{else}}
                    <div class="alert alert-info">
                        <h5>No Results Found</h5>
                        <p class="mb-0">No anime found matching "{{query}}"</p>
                    </div>
                {{/if}}
            {{else}}
                <div class="alert alert-warning">
                    <p class="mb-0">Try searching with different keywords.</p>
                </div>
            {{/if}}
        {{else}}
            <div class="alert alert-info">
                <p class="mb-0">Enter a title above to search for anime.</p>
            </div>
        {{/if}}

        <div class="mt-4">
            <a href="/" class="btn btn-primary">← Back to Home</a>
        </div>
    </div>
</body>
</html>
