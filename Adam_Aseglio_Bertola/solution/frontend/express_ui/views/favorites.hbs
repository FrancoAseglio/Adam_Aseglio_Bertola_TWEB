<!DOCTYPE html>
<html>
<head>
    <title>{{title}}</title>
</head>
<body>
    <h1>{{title}}</h1>
    
    {{#if favorites}}
        <p>Total favorites: {{favorites.length}}</p>
        <pre>{{json favorites}}</pre>
    {{else}}
        <p>No favorites found for this user.</p>
    {{/if}}
    
    <br>
    <a href="/">← Back to Home</a>
</body>
</html>
