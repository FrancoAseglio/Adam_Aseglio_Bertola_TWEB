<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
    {{> navbar}}
    
    {{#if person}}
    <div class="header-gradient purple">
        <div class="container">
            <h1>{{person.name}}</h1>
            {{#if person.given_name}}
                <p>{{person.given_name}} {{person.family_name}}</p>
            {{/if}}
        </div>
    </div>

    <div class="container py-4">
        <div class="row g-4">
            <!-- Person Image -->
            <div class="col-md-4">
                <div class="character-detail-image">
                    {{#if person.image_url}}
                        <img src="{{person.image_url}}" alt="{{person.name}}" onerror="this.src='https://via.placeholder.com/225x350/9333ea/ffffff?text=No+Image'">
                    {{else}}
                        <img src="https://via.placeholder.com/225x350/9333ea/ffffff?text=No+Image" alt="No image available">
                    {{/if}}
                </div>

                {{#if person.favorites}}
                    <div class="card mt-3 text-center border-0 shadow-lg" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                        <div class="card-body py-4">
                            <div style="font-size: 3rem;">❤️</div>
                            <div class="stat-value fw-bold" style="font-size: 2.5rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">{{person.favorites}}</div>
                            <div class="stat-label fw-semibold" style="font-size: 1.1rem; letter-spacing: 1px; text-transform: uppercase;">users</div>
                        </div>
                    </div>
                {{/if}}

                {{#if person.website_url}}
                    <div class="card mt-3 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <a href="{{person.website_url}}" target="_blank" class="btn btn-primary btn-sm">
                                🌐 Visit Website
                            </a>
                        </div>
                    </div>
                {{/if}}
            </div>

            <!-- Person Details -->
            <div class="col-md-8">
                <div class="info-card-detail">
                    <h3>Person Information</h3>

                    <div>
                        <p class="mb-2"><strong>Name:</strong> {{person.name}}</p>

                        {{#if person.given_name}}
                        <p class="mb-2"><strong>Given Name:</strong> {{person.given_name}}</p>
                        {{/if}}

                        {{#if person.family_name}}
                        <p class="mb-2"><strong>Family Name:</strong> {{person.family_name}}</p>
                        {{/if}}

                        {{#if person.alternate_names}}
                        <p class="mb-2"><strong>Alternate Names:</strong> {{formatList person.alternate_names}}</p>
                        {{/if}}

                        {{#if person.birthday}}
                        <p class="mb-2"><strong>Birthday:</strong> {{person.birthday}}</p>
                        {{/if}}

                        {{#if person.relevant_location}}
                        <p class="mb-2"><strong>Location:</strong> {{person.relevant_location}}</p>
                        {{/if}}

                        {{#if person.url}}
                        <p class="mb-2"><strong>MyAnimeList:</strong> <a href="{{person.url}}" target="_blank" class="text-decoration-none">View on MAL →</a></p>
                        {{/if}}

                    </div>
                </div>

                {{#if person.about}}
                <div class="info-card-detail">
                    <h3>About</h3>
                    <p class="about-text">{{person.about}}</p>
                </div>
                {{/if}}

                {{#if person.website_url}}
                <div class="info-card-detail">
                    <h3>Links</h3>
                    <p><a href="{{person.website_url}}" target="_blank" class="text-decoration-none">🌐 Official Website</a></p>
                </div>
                {{/if}}
            </div>
        </div>

        <div class="actions">
            <a href="#" onclick="history.back(); return false;" class="btn btn-outline-primary">← Back to Results</a>
        </div>
    </div>
    {{else}}
    <div class="container py-5">
        <div class="not-found">
            <h2>😕 Person Not Found</h2>
            <p>The person you're looking for doesn't exist or couldn't be loaded.</p>
        </div>
        <div class="actions">
            <a href="#" onclick="history.back(); return false;" class="btn btn-outline-primary">← Back to Results</a>
        </div>
    </div>
    {{/if}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
