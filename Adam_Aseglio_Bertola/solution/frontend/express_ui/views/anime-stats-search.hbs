<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
    {{> navbar}}
    
    <div class="header-gradient primary">
        <div class="container">
            <h1>🔍 Search Anime Statistics</h1>
            <p>Search for an anime to view its statistics</p>
        </div>
    </div>

    <div class="container py-4">
        <div class="card mb-4">
            <div class="card-body">
                <form action="/stats/search" method="GET">
                    <div class="input-group">
                        <input type="text" name="title" class="form-control" placeholder="Enter anime title..." value="{{query}}" required>
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </form>
            </div>
        </div>

        {{#if query}}
            {{#if results}}
                {{#if results.length}}
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">Search Results for "{{query}}" ({{results.length}} found)</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                {{#each results}}
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 hover-lift" style="cursor: pointer;" onclick="window.location.href='/stats/anime/{{this.animeMalId}}'">
                                        <div class="card-body">
                                            <h6 class="card-title">{{this.title}}</h6>
                                            <p class="card-text text-muted small mb-1">ID: {{this.animeMalId}}</p>
                                            {{#if this.type}}
                                            <p class="card-text text-muted small mb-1">Type: {{this.type}}</p>
                                            {{/if}}
                                            {{#if this.score}}
                                            <p class="card-text text-muted small mb-0">⭐ Score: {{this.score}}</p>
                                            {{/if}}
                                        </div>
                                    </div>
                                </div>
                                {{/each}}
                            </div>
                        </div>
                    </div>
                {{else}}
                    <div class="alert alert-info">
                        <h5>No Results Found</h5>
                        <p class="mb-0">No anime found matching "{{query}}". Try searching with different keywords.</p>
                    </div>
                {{/if}}
            {{else}}
                <div class="alert alert-warning">
                    <p class="mb-0">{{error}}</p>
                </div>
            {{/if}}
        {{else}}
            <div class="alert alert-info">
                <p class="mb-0">Enter a title above to search for anime statistics.</p>
            </div>
        {{/if}}

        <div class="mt-4">
            <a href="/" class="btn btn-primary">← Back to Home</a>
        </div>
    </div>
</body>
</html>
