<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
    {{#if stats}}
    <div class="header-gradient primary">
        <div class="container">
            <h1>📊 Anime Statistics</h1>
            {{#if animeDetails}}
            <p>{{animeDetails.title}}</p>
            {{/if}}
        </div>
    </div>

    <div class="container py-4">
        {{#if animeDetails}}
        {{#if animeDetails.image_url}}
        <div class="text-center mb-4">
            <img src="{{animeDetails.image_url}}" alt="{{animeDetails.title}}" style="max-width: 280px; border-radius: 12px;" onerror="this.src='https://via.placeholder.com/225x350/667eea/ffffff?text=No+Image'">
        </div>
        {{/if}}
        {{/if}}

        <div class="section">
            <h2 class="section-title">👥 Watch Status Distribution</h2>
            <div class="status-grid">
                <div class="stat-box watching">
                    <div class="stat-value">{{stats.watching}}</div>
                    <div class="stat-label">Watching</div>
                </div>
                <div class="stat-box completed">
                    <div class="stat-value">{{stats.completed}}</div>
                    <div class="stat-label">Completed</div>
                </div>
                <div class="stat-box on-hold">
                    <div class="stat-value">{{stats.on_hold}}</div>
                    <div class="stat-label">On Hold</div>
                </div>
                <div class="stat-box dropped">
                    <div class="stat-value">{{stats.dropped}}</div>
                    <div class="stat-label">Dropped</div>
                </div>
                <div class="stat-box plan-to-watch">
                    <div class="stat-value">{{stats.plan_to_watch}}</div>
                    <div class="stat-label">Plan to Watch</div>
                </div>
            </div>
            {{#if stats.total}}
            <p class="text-center text-muted mt-4"><strong>Total Users:</strong> {{stats.total}}</p>
            {{/if}}
        </div>

        {{#if stats.score_10_votes}}
        <div class="section">
            <h2 class="section-title">⭐ Score Distribution</h2>
            <div class="score-bars-container">
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">10</span>
                        <span class="score-votes">{{stats.score_10_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_10_percentage}}%; background: linear-gradient(90deg, #22c55e 0%, #16a34a 100%);">
                            <span class="score-percentage">{{stats.score_10_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">9</span>
                        <span class="score-votes">{{stats.score_9_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_9_percentage}}%; background: linear-gradient(90deg, #84cc16 0%, #65a30d 100%);">
                            <span class="score-percentage">{{stats.score_9_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">8</span>
                        <span class="score-votes">{{stats.score_8_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_8_percentage}}%; background: linear-gradient(90deg, #eab308 0%, #ca8a04 100%);">
                            <span class="score-percentage">{{stats.score_8_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">7</span>
                        <span class="score-votes">{{stats.score_7_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_7_percentage}}%; background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);">
                            <span class="score-percentage">{{stats.score_7_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">6</span>
                        <span class="score-votes">{{stats.score_6_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_6_percentage}}%; background: linear-gradient(90deg, #f97316 0%, #ea580c 100%);">
                            <span class="score-percentage">{{stats.score_6_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">5</span>
                        <span class="score-votes">{{stats.score_5_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_5_percentage}}%; background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);">
                            <span class="score-percentage">{{stats.score_5_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">4</span>
                        <span class="score-votes">{{stats.score_4_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_4_percentage}}%; background: linear-gradient(90deg, #ec4899 0%, #db2777 100%);">
                            <span class="score-percentage">{{stats.score_4_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">3</span>
                        <span class="score-votes">{{stats.score_3_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_3_percentage}}%; background: linear-gradient(90deg, #a855f7 0%, #9333ea 100%);">
                            <span class="score-percentage">{{stats.score_3_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">2</span>
                        <span class="score-votes">{{stats.score_2_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_2_percentage}}%; background: linear-gradient(90deg, #8b5cf6 0%, #7c3aed 100%);">
                            <span class="score-percentage">{{stats.score_2_percentage}}%</span>
                        </div>
                    </div>
                </div>
                <div class="score-bar-item">
                    <div class="score-bar-label">
                        <span class="score-number">1</span>
                        <span class="score-votes">{{stats.score_1_votes}} votes</span>
                    </div>
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{stats.score_1_percentage}}%; background: linear-gradient(90deg, #64748b 0%, #475569 100%);">
                            <span class="score-percentage">{{stats.score_1_percentage}}%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

        {{else}}
        <div class="not-found">
            <h2>😕 Statistics Not Found</h2>
            <p>No statistics available for this anime.</p>
        </div>
        {{/if}}

        <div class="actions">
            <a href="#" onclick="history.back(); return false;" class="back-button">← Back to Results</a>
            <a href="/" class="back-button">🏠 Home</a>
            {{#if animeDetails}}
            <a href="/anime/{{animeDetails.mal_id}}" class="back-button">📖 View Anime Details</a>
            {{/if}}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
