{{#if pagination}}
{{#if (gt pagination.totalPages 1)}}
<nav aria-label="Search results pagination" class="mt-4">
  <ul class="pagination justify-content-center">
    <!-- Previous Button -->
    {{#if pagination.hasPrevPage}}
    <li class="page-item">
      <a class="page-link" href="{{#if baseUrl}}{{baseUrl}}{{#if urlSeparator}}{{urlSeparator}}{{else}}&{{/if}}page={{minus pagination.currentPage 1}}
              {{else}}?{{#if searchTitle}}title={{searchTitle}}&{{/if}}{{#if searchLimit}}limit={{searchLimit}}&{{/if}}
              {{#if name}}name={{name}}&{{/if}}page={{minus pagination.currentPage 1}}{{/if}}" aria-label="Previous">
        <span aria-hidden="true">&laquo; Previous</span>
      </a>
    </li>
    {{else}}
    <li class="page-item disabled">
      <span class="page-link">&laquo; Previous</span>
    </li>
    {{/if}}

    <!-- Page Numbers -->
    {{#each (generatePageNumbers pagination.currentPage pagination.totalPages)}}
    {{#if (eq this ../pagination.currentPage)}}
    <li class="page-item active" aria-current="page">
      <span class="page-link">{{this}}</span>
    </li>
    {{else if (eq this "...")}}
    <li class="page-item disabled">
      <span class="page-link">...</span>
    </li>
    {{else}}
    <li class="page-item">
      <a class="page-link"
        href="{{#if ../baseUrl}}{{../baseUrl}}{{#if ../urlSeparator}}{{../urlSeparator}}{{else}}&{{/if}}page={{this}}
              {{else}}?{{#if ../searchTitle}}title={{../searchTitle}}&{{/if}}
              {{#if ../searchLimit}}limit={{../searchLimit}}&{{/if}}{{#if ../name}}name={{../name}}&{{/if}}page={{this}}{{/if}}">{{this}}</a>
    </li>
    {{/if}}
    {{/each}}

    <!-- Next Button -->
    {{#if pagination.hasNextPage}}
    <li class="page-item">
      <a class="page-link"
        href="{{#if baseUrl}}{{baseUrl}}{{#if urlSeparator}}{{urlSeparator}}{{else}}&{{/if}}page={{plus pagination.currentPage 1}}
              {{else}}?{{#if searchTitle}}title={{searchTitle}}&{{/if}}
              {{#if searchLimit}}limit={{searchLimit}}&{{/if}}{{#if name}}name={{name}}&{{/if}}page={{plus pagination.currentPage 1}}{{/if}}"
        aria-label="Next">
        <span aria-hidden="true">Next &raquo;</span>
      </a>
    </li>
    {{else}}
    <li class="page-item disabled">
      <span class="page-link">Next &raquo;</span>
    </li>
    {{/if}}
  </ul>

  <!-- Pagination Info -->
  <div class="text-center text-muted small mt-2">
    Showing {{plus (multiply (minus pagination.currentPage 1) pagination.itemsPerPage) 1}} -
    {{#if (lt (multiply pagination.currentPage pagination.itemsPerPage) pagination.totalItems)}}
    {{multiply pagination.currentPage pagination.itemsPerPage}}
    {{else}}
    {{pagination.totalItems}}
    {{/if}}
    of {{pagination.totalItems}} results
  </div>
</nav>
{{/if}}
{{/if}}
