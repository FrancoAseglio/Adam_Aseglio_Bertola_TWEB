<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
    <div class="header-gradient primary">
        <div class="container">
            <h1>📊 {{title}}</h1>
            {{#if stats.calculatedAt}}
            <p>Last updated: {{stats.calculatedAt}}</p>
            {{/if}}
        </div>
    </div>

    <div class="container py-4">
        {{#if stats}}
        <div class="stats-grid">
            <div class="stat-card anime">
                <div class="stat-icon">🎬</div>
                <div class="stat-value">{{stats.totalAnime}}</div>
                <div class="stat-label">Total Anime</div>
            </div>

            <div class="stat-card profiles">
                <div class="stat-icon">👥</div>
                <div class="stat-value">{{stats.totalProfiles}}</div>
                <div class="stat-label">Total Users</div>
            </div>

            <div class="stat-card ratings">
                <div class="stat-icon">⭐</div>
                <div class="stat-value">{{stats.totalRatings}}</div>
                <div class="stat-label">Total Ratings</div>
            </div>

            <div class="stat-card favorites">
                <div class="stat-icon">❤️</div>
                <div class="stat-value">{{stats.totalFavorites}}</div>
                <div class="stat-label">Total Favorites</div>
            </div>
        </div>
        {{else}}
        <div class="not-found">
            <h2>📊 No Statistics Available</h2>
            <p>Statistics could not be loaded at this time.</p>
        </div>
        {{/if}}

        <div class="actions">
            <a href="/" class="back-button">← Back to Home</a>
            <a href="/stats/global" class="refresh-button">🔄 Refresh Stats</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
