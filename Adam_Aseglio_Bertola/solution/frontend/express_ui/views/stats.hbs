<h1>{{title}}</h1>

<!-- Global Statistics -->
{{#if globalStats}}
<div style="margin: 20px 0; padding: 20px; background: #f5f5f5; border-radius: 8px;">
    <h2>📊 Platform Statistics</h2>
    <div style="margin-top: 15px;">
        <p><strong>🎬 Total Anime:</strong> {{globalStats.totalAnime}}</p>
        <p><strong>👥 Total Users:</strong> {{globalStats.totalProfiles}}</p>
        <p><strong>⭐ Total Ratings:</strong> {{globalStats.totalRatings}}</p>
        <p><strong>❤️ Total Favorites:</strong> {{globalStats.totalFavorites}}</p>
    </div>
</div>
{{/if}}

