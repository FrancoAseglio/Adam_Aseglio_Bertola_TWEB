<h1>{{title}}</h1>

<!-- Global Statistics -->
{{#if globalStats}}
<div style="margin: 20px 0; padding: 20px; background: #f5f5f5; border-radius: 8px;">
    <h2>📊 Platform Statistics</h2>
    <div style="margin-top: 15px;">
        <p><strong>Total Anime:</strong> {{globalStats.totalAnime}}</p>
        <p><strong>Total Users:</strong> {{globalStats.totalProfiles}}</p>
        <p><strong>Total Ratings:</strong> {{globalStats.totalRatings}}</p>
        <p><strong>Total Favorites:</strong> {{globalStats.totalFavorites}}</p>
    </div>
</div>
{{/if}}

<h1>{{title}}</h1>

<!-- Global Statistics -->
{{#if globalStats}}
<div style="margin: 20px 0; padding: 20px; background: #f5f5f5; border-radius: 8px;">
    <h2>📊 Platform Statistics</h2>
    <div style="margin-top: 15px;">
        <p><strong>🎬 Total Anime:</strong> {{globalStats.totalAnime}}</p>
        <p><strong>👥 Total Users:</strong> {{globalStats.totalProfiles}}</p>
        <p><strong>⭐ Total Ratings:</strong> {{globalStats.totalRatings}}</p>
        <p><strong>❤️ Total Favorites:</strong> {{globalStats.totalFavorites}}</p>
    </div>
</div>
{{/if}}

<h1>Anime Search</h1>

<!-- Browse Anime Section -->
<div id="anime-section" class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
            </div>
            <div class="card-body">
                <input type="text" class="form-control mb-3" id="searchQuery" placeholder="Enter anime title">
                <button class="btn btn-info" onclick="searchAnime()">Search</button>
            </div>
        </div>
    </div>
</div>

<h1>Search Character</h1>

<!-- Browse Character Section -->
<div id="character-section" class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
            </div>
            <div class="card-body">
                <input type="text" class="form-control mb-3" id="searchCharacterQuery" placeholder="Enter character name">
                <button class="btn btn-info" onclick="searchCharacter()">Search</button>
            </div>
        </div>
    </div>
</div>
