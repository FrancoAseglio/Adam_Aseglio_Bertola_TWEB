<h1>{{title}}</h1>

<p><a href="/stats">📊 View Platform Statistics</a></p>

<h1>Anime Search</h1>

<!-- Browse Anime Section -->
<div id="anime-section" class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
            </div>
            <div class="card-body">
                <input type="text" class="form-control mb-3" id="searchQuery" placeholder="Enter anime title">
                <button class="btn btn-info" onclick="searchAnime()">Search</button>
            </div>
        </div>
    </div>
</div>

<h1>Anime Detail</h1>

<!-- Anime Detail Section -->
<div id="anime-detail-section" class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
            </div>
            <div class="card-body">
                <input type="text" class="form-control mb-3" id="animeId" placeholder="Enter anime ID (e.g., 20)">
                <button class="btn btn-info" onclick="getAnimeDetail()">View Detail</button>
            </div>
        </div>
    </div>
</div>

<h1>Search Character</h1>

<!-- Browse Character Section -->
<div id="character-section" class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
            </div>
            <div class="card-body">
                <input type="text" class="form-control mb-3" id="searchCharacterQuery" placeholder="Enter character name">
                <button class="btn btn-info" onclick="searchCharacter()">Search</button>
            </div>
        </div>
    </div>
</div>

<h1>User Profile</h1>

<!-- User Profile Section -->
<div id="profile-section" style="margin-top: 15px;">
    <div style="max-width: 500px;">
        <input type="text" class="form-control mb-3" id="profileUsername" placeholder="Enter username">
        <button class="btn btn-info" onclick="getUserProfile()">View Profile</button>
    </div>
</div>

<h1>User Ratings</h1>

<!-- User Ratings Section -->
<div id="ratings-section" style="margin-top: 15px;">
    <div style="max-width: 500px;">
        <input type="text" class="form-control mb-3" id="ratingUsername" placeholder="Enter username">
        <button class="btn btn-info" onclick="getUserRatings()">Search</button>
    </div>
</div>

<h1>User Favorites</h1>

<!-- User Favorites Section -->
<div id="favorites-section" style="margin-top: 15px;">
    <div style="max-width: 500px;">
        <input type="text" class="form-control mb-3" id="favUsername" placeholder="Enter username">
        <button class="btn btn-info" onclick="getUserFavorites()">Search</button>
    </div>
</div>

<h1>User Statistics</h1>

<!-- User Statistics Section -->
<div id="stats-section" style="margin-top: 15px;">
    <div style="max-width: 500px;">
        <input type="text" class="form-control mb-3" id="statsUsername" placeholder="Enter username">
        <button class="btn btn-info" onclick="getUserStats()">View Statistics</button>
    </div>
</div>

<h1>Anime Recommendations</h1>

<!-- Anime Recommendations Section -->
<div id="recommendations-section" style="margin-top: 15px;">
    <div style="max-width: 500px;">
        <input type="text" class="form-control mb-3" id="recommendationMalId" placeholder="Enter anime ID (e.g., 20)">
        <button class="btn btn-info" onclick="getAnimeRecommendations()">View Recommendations</button>
    </div>
</div>

<h1>Anime Statistics</h1>

<!-- Anime Statistics Section -->
<div id="anime-stats-section" style="margin-top: 15px;">
    <div style="max-width: 500px;">
        <input type="text" class="form-control mb-3" id="animeStatsId" placeholder="Enter anime ID (e.g., 21)">
        <button class="btn btn-info" onclick="getAnimeStatistics()">View Anime Statistics</button>
    </div>
</div>
