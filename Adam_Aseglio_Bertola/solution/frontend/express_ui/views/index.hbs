<h1>Anime Search</h1>

<!-- Browse Anime Section -->
<div id="anime-section" class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
            </div>
            <div class="card-body">
                <input type="text" class="form-control mb-3" id="searchQuery" placeholder="Enter anime title">
                <button class="btn btn-info" onclick="searchAnime()">Search</button>
            </div>
        </div>
    </div>
</div>

<h1>Search Character</h1>

<!-- Browse Character Section -->
<div id="character-section" class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-info text-white">
            </div>
            <div class="card-body">
                <input type="text" class="form-control mb-3" id="searchCharacterQuery" placeholder="Enter character name">
                <button class="btn btn-info" onclick="searchCharacter()">Search</button>
            </div>
        </div>
    </div>
</div>
