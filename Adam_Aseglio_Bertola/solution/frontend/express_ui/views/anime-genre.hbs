<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
    {{> navbar}}
    
    <div class="header-gradient orange">
        <div class="container">
            <h1>🎭 {{title}}</h1>
            <p>Anime in the {{genre}} genre</p>
        </div>
    </div>

    <div class="container py-4">
        {{#if results}}
            {{#if results.length}}
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">{{genre}} Anime ({{results.length}} found)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            {{#each results}}
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 hover-lift" style="cursor: pointer;" onclick="window.location.href='/anime/{{this.animeMalId}}'">
                                    <div class="card-body">
                                        <h6 class="card-title">{{this.title}}</h6>
                                        <p class="card-text text-muted small mb-1">ID: {{this.animeMalId}}</p>
                                        {{#if this.type}}
                                        <p class="card-text text-muted small mb-1">Type: {{this.type}}</p>
                                        {{/if}}
                                        {{#if this.episodes}}
                                        <p class="card-text text-muted small mb-1">Episodes: {{this.episodes}}</p>
                                        {{/if}}
                                        {{#if this.score}}
                                        <p class="card-text mb-0">
                                            <span class="badge bg-success">⭐ {{this.score}}</span>
                                        </p>
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            {{else}}
                <div class="alert alert-info">
                    <h5>No Results Found</h5>
                    <p class="mb-0">No anime found in the "{{genre}}" genre.</p>
                </div>
            {{/if}}
        {{else}}
            <div class="alert alert-warning">
                <p class="mb-0">Unable to load anime for this genre.</p>
            </div>
        {{/if}}

    </div>
</body>
</html>
